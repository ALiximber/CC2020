# Copia este archivo como .env.local y coloca tu clave de Google AI Studio.
# NUNCA subas .env.local a GitHub.

# Clave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo Gemini Flash (opcional). Si se deja vacío se usa gemini-2.5-flash.
# Consulta los modelos disponibles para tu cuenta en https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash

# Modelo de respaldo si el principal no existe o está saturado (opcional).
GEMINI_FALLBACK_MODEL=gemini-flash-latest

